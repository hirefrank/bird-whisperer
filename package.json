{
  "name": "bird-whisperer",
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --remote",
    "dev:local": "wrangler dev --remote -c wrangler.local.toml",
    "deploy": "wrangler deploy",
    "deploy:local": "wrangler deploy -c wrangler.local.toml",
    "kv:create": "wrangler kv:namespace create BIRD_WHISPERER",
    "trigger:enable": "echo 'true' | wrangler secret put ENABLE_MANUAL_TRIGGER",
    "trigger:disable": "echo 'false' | wrangler secret put ENABLE_MANUAL_TRIGGER",
    "trigger": "node scripts/trigger.mjs",
    "config:push": "./scripts/push-config-secret.sh",
    "kv:reset": "./scripts/kv-reset.sh",
    "typecheck": "tsc --noEmit"
  },
  "cloudflare": {
    "bindings": {
      "X_BEARER_TOKEN": {
        "description": "X API Bearer token for reading tweets via v2 API."
      },
      "GEMINI_API_KEY": {
        "description": "Google Gemini API key used for digest summarization."
      },
      "RESEND_API_KEY": {
        "description": "Optional when using Resend email delivery. Not required if using Cloudflare Email Service."
      },
      "CONFIG_YAML": {
        "description": "Optional full YAML config override. If set, this takes precedence over bundled `config.yaml`."
      },
      "EMAIL_PROVIDER": {
        "description": "Optional provider override: `resend` or `cloudflare`."
      },
      "EMAIL_FROM": {
        "description": "Optional sender override, e.g. `Bird Whisperer <noreply@yourdomain.com>`."
      },
      "EMAIL_REPLY_TO": {
        "description": "Optional reply-to override for outbound digest emails."
      }
    }
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.43",
    "ai": "^6.0.116",
    "hono": "^4.0.0",
    "js-yaml": "^4.1.0",
    "marked": "^17.0.1",
    "resend": "^4.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.0",
    "wrangler": "4"
  }
}
